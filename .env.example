# ==============================================================================
# GyaniTalk - Environment Configuration Example
# Copy this file to .env and replace the placeholders with your actual values.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (Prisma & MariaDB / MySQL)
# ------------------------------------------------------------------------------
DATABASE_URL="mysql://USER:PASSWORD@HOST:PORT/DATABASE?serverTimezone=Asia/Kolkata&connection_limit=10&pool_timeout=30"

# ------------------------------------------------------------------------------
# 2. JWT & AUTHENTICATION SECRETS
# ------------------------------------------------------------------------------
JWT_SECRET="your-jwt-secret-here"
JWT_REFRESH_SECRET="your-jwt-refresh-secret-here"

# ------------------------------------------------------------------------------
# 3. AWS S3 STORAGE & ASSET MANAGEMENT
# ------------------------------------------------------------------------------
AWS_ACCESS_KEY_ID="your-aws-access-key-id"
AWS_SECRET_ACCESS_KEY="your-aws-secret-access-key"
AWS_REGION="ap-south-1"
AWS_BUCKET_NAME="your-s3-bucket-name"
NEXT_PUBLIC_BASEURL="https://your-s3-bucket-name.s3.ap-south-1.amazonaws.com"
NEXT_PUBLIC_ASSET_BASE_URL="https://your-s3-bucket-name.s3.ap-south-1.amazonaws.com"
UPLOAD_PATH="public/storage/"
NEXT_PUBLIC_CHAPTER_UPLOAD_PATH="public/upload/"
UPLOAD_FS_ROOT="public/storage"
UPLOAD_S3_PREFIX="public/storage"

# ------------------------------------------------------------------------------
# 4. SITE & APPLICATION METADATA
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV="development"
NEXT_PUBLIC_SITE_NAME="GyaniTalk"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
API_PUBLIC_URL="http://localhost:3000"
NEXT_PUBLIC_TWITTER_HANDLE="@gyanitalk"
NEXT_PUBLIC_FACEBOOK_PAGE="gyanitalk"
INDEXNOW_KEY=""
CRON_SECRET="your-secure-cron-secret"

# ------------------------------------------------------------------------------
# 5. FIREBASE ADMIN SDK CONFIGURATION
# ------------------------------------------------------------------------------
FIREBASE_TYPE="service_account"
FIREBASE_PROJECT_ID="your-firebase-project-id"
FIREBASE_PRIVATE_KEY_ID="your-firebase-private-key-id"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk@your-project-id.iam.gserviceaccount.com"
FIREBASE_CLIENT_ID="your-firebase-client-id"
FIREBASE_AUTH_URI="https://accounts.google.com/o/oauth2/auth"
FIREBASE_TOKEN_URI="https://oauth2.googleapis.com/token"
FIREBASE_AUTH_PROVIDER_X509_CERT_URL="https://www.googleapis.com/oauth2/v1/certs"
FIREBASE_CLIENT_X509_CERT_URL="https://www.googleapis.com/robot/v1/metadata/x509/firebase-adminsdk%40your-project-id.iam.gserviceaccount.com"
FIREBASE_STORAGE_BUCKET="your-project-id.appspot.com"
UNIVERSE_DOMAIN="googleapis.com"

# ------------------------------------------------------------------------------
# 6. ASTROLOGY & HOROSCOPE SERVICES
# ------------------------------------------------------------------------------
ASTROLOGYAPI_USER_ID="your-astrology-api-user-id"
ASTROLOGYAPI_API_KEY="your-astrology-api-key"
ASTROLOGYAPI_BASE_URL="https://json.astrologyapi.com"
VEDICASTRO_API_KEY="your-vedicastro-api-key"
KUNDALI_PATH="./public/kundli"

# ------------------------------------------------------------------------------
# 7. SMS / OTP SERVICES (MSG91)
# ------------------------------------------------------------------------------
OTP_SERVICE_PROVIDER="msg91"
OTP_API_KEY="your-otp-api-key"
MSG91_TEMPLATE_ID="your-msg91-template-id"
OTP_SENDER_ID="GYNTLK"
MASTER_OTP="999999"

# ------------------------------------------------------------------------------
# 8. PAYMENT GATEWAY (Razorpay)
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID="rzp_test_yourKeyId"
RAZORPAY_KEY_SECRET="yourRazorpayKeySecret"
RAZORPAY_WEBHOOK_SECRET="yourRazorpayWebhookSecret"

# ------------------------------------------------------------------------------
# 9. TELEPHONY & VOICE CALLING (Exotel)
# ------------------------------------------------------------------------------
EXOTEL_API_KEY="your-exotel-api-key"
EXOTEL_API_TOKEN="your-exotel-api-token"
EXOTEL_ACCOUNT_SID="your-exotel-account-sid"
EXOTEL_CALLER_ID="your-exotel-caller-id"
EXOTEL_SUBDOMAIN="api.exotel.com"

# ------------------------------------------------------------------------------
# 10. REAL-TIME AUDIO / VIDEO (Agora)
# ------------------------------------------------------------------------------
AGORA_CUSTOMER_ID="your-agora-customer-id"
AGORA_CUSTOMER_SECRET="your-agora-customer-secret"
AGORA_APP_ID="your-agora-app-id"

# ------------------------------------------------------------------------------
# 11. SECURITY, SESSIONS & PAGINATION
# ------------------------------------------------------------------------------
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15
OTP_EXPIRY_MINUTES=5
SESSION_EXPIRY_DAYS=30
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
SOFT_DELETE_GRACE_PERIOD_DAYS=20

# ------------------------------------------------------------------------------
# 12. EMAIL SERVICE (Optional)
# ------------------------------------------------------------------------------
EMAIL_SERVICE_PROVIDER="mock"
EMAIL_API_KEY=""
EMAIL_FROM="noreply@gyanitalk.com"
EMAIL_VERIFY_URL="http://localhost:3000/verify-email"
