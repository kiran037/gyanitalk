generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model admin_get_commissions {
  id               BigInt           @id @default(autoincrement()) @db.UnsignedBigInt
  commissionTypeId BigInt           @db.UnsignedBigInt
  amount           Float
  commissionId     BigInt?          @db.UnsignedBigInt
  description      String?          @db.VarChar(100)
  orderId          Int?
  isActive         Boolean          @default(true)
  isDelete         Boolean          @default(false)
  created_at       DateTime?        @default(now()) @db.Timestamp(0)
  updated_at       DateTime?        @default(now()) @db.Timestamp(0)
  createdBy        Int
  modifiedBy       Int
  commissions      commissions?     @relation(fields: [commissionId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "admin_get_commissions_commissionid_foreign")
  commission_types commission_types @relation(fields: [commissionTypeId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "admin_get_commissions_commissiontypeid_foreign")

  @@index([commissionId], map: "admin_get_commissions_commissionid_foreign")
  @@index([commissionTypeId], map: "admin_get_commissions_commissiontypeid_foreign")
}

model adminpages {
  id           Int       @id @default(autoincrement())
  pageName     String?   @db.VarChar(45)
  pageGroup    Int?
  icon         String?   @db.VarChar(45)
  route        String?   @db.VarChar(45)
  displayOrder Int?
  created_at   DateTime? @db.Timestamp(0)
  updated_at   DateTime? @db.Timestamp(0)
}

model app_reviews {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  userId     BigInt    @db.UnsignedBigInt
  review     String    @db.LongText
  isActive   Boolean   @default(true)
  isDelete   Boolean   @default(false)
  appId      Int
  created_at DateTime? @db.Timestamp(0)
  updated_at DateTime? @db.Timestamp(0)
  createdBy  Int
  modifiedBy Int
  users      users     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "app_reviews_userid_foreign")

  @@index([userId], map: "app_reviews_userid_foreign")
}

model assistantchat {
  id           Int      @id @default(autoincrement())
  senderId     Int
  receiverId   Int
  chatId       String   @db.VarChar(20)
  created_at   DateTime @default(now()) @db.Timestamp(0)
  updated_at   DateTime @default(now()) @db.Timestamp(0)
  astrologerId BigInt
  customerId   Int

  astrologer   astrologers @relation(fields: [astrologerId], references: [id])
}

model astrohost {
  id           Int       @id @default(autoincrement())
  astrologerId BigInt?   @db.UnsignedBigInt
  hostId       Int?
  created_at   DateTime? @default(now()) @db.Timestamp(0)
  updated_at   DateTime? @default(now()) @db.Timestamp(0)

  @@index([astrologerId], map: "astrohost_astrologer_idx")
}

model astrologer_assign_group {
