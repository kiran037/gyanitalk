model callrequest {
  id                      Int       @id @default(autoincrement())
  userId                  BigInt    @db.UnsignedBigInt
  astrologerId            BigInt?   @db.UnsignedBigInt
  callStatus              String?   @db.VarChar(45)
  channelName             String?   @db.VarChar(45)
  token                   String?   @db.VarChar(400)
  totalMin                String?   @db.VarChar(45)
  callRate                String?   @db.VarChar(45)
  deduction               Float?
  call_duration           String?   @db.VarChar(255)
  created_at              DateTime? @default(now()) @db.Timestamp(0)
  updated_at              DateTime? @default(now()) @db.Timestamp(0)
  deductionFromAstrologer Float?
  sId                     String?   @db.VarChar(45)
  sId1                    String?   @db.VarChar(45)
  chatId                  String?   @db.VarChar(200)
  isFreeSession           Boolean?
  call_type               Int       @default(0)

  astrologer   astrologers?  @relation("AstrologerToCallRequests", fields: [astrologerId], references: [id])  
  user         users?         @relation("UserToCallRequests", fields: [userId], references: [id])
  order_requests order_request[]

  @@index([astrologerId], map: "callrequest_astrologer_idx")
  @@index([userId], map: "callrequest_user_idx")
}



