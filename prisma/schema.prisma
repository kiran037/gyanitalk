  coupon_user_usages coupon_user_usages[]
  userRoles  user_roles[]
  reviews  user_reviews[]
  tickets tickets[]
  liveuser    liveuser[]    
  payments payment[]
  order_request order_request[]
  blocks    blockastrologer[]
  userNotifications  user_notifications[]
  followedAstrologers astrologer_followers[] @relation("UserFollowers")
  wallettransactions wallettransaction[] @relation("UserWalletRelation")
  user_wallets user_wallets[]  
  user_device_details user_device_details[] @relation("UserToDeviceDetails")
  chatrequests    chatrequest[]   @relation("UserChatRequests")
  callrequests callrequest[] @relation("UserToCallRequests")
  astrologerGifts    astrologer_gifts[]   @relation("UserGiftsRelation")
}

model waitlist {
  id           Int       @id @default(autoincrement())
  userName     String?   @db.VarChar(45)
  profile      String?   @db.VarChar(400)
  time         String?   @db.VarChar(45)
  channelName  String?   @db.VarChar(45)
  requestType  String?   @db.VarChar(45)
  created_at   DateTime? @default(now()) @db.Timestamp(0)
  updated_at   DateTime? @default(now()) @db.Timestamp(0)
  status       String?   @db.VarChar(45)
  userId       Int?
  userFcmToken String?   @db.VarChar(400)
  astrologerId Int
}

model wallettransaction {
  id               Int       @id @default(autoincrement())
  amount           Float?
  userId           BigInt? @db.UnsignedBigInt
  referred_user_id Int?
  transactionType  String?   @db.VarChar(45)
  transaction_id   String?   @db.Text
  orderId          BigInt?
  astrologerId     BigInt?
  aiAstrologerId   BigInt?
  created_at       DateTime? @default(now()) @db.Timestamp(0)
  updated_at       DateTime? @default(now()) @db.Timestamp(0)
  createdBy        Int?
  modifiedBy       Int?
  isCredit         Boolean?

  // Relations
  order_request order_request? @relation(fields: [orderId], references: [id])
  astrologer     astrologers?  @relation(fields: [astrologerId], references: [id])
  ai_astrologer     aiastrologers?     @relation("AiAstroWalletRelation", fields: [aiAstrologerId], references: [id])
  user users? @relation("UserWalletRelation", fields: [userId], references: [id]) 

  @@index([astrologerId], map: "astrologerId")
  @@index([orderId], map: "orderId")
  @@index([referred_user_id], map: "referred_user_id")
  @@index([userId], map: "userId")
}


model withdrawmethods {
  id          Int       @id @default(autoincrement())
  method_name String?   @db.VarChar(255)
  method_id   Int?
  isActive    Boolean?
  created_at  DateTime? @default(now()) @db.Timestamp(0)
  updated_at  DateTime? @default(now()) @db.Timestamp(0)

  withdraws   withdrawrequest[]
}

model withdrawrequest {
  id                Int       @id @default(autoincrement())
  astrologerId      BigInt?   @db.UnsignedBigInt
  withdrawAmount    Decimal?  @db.Decimal(10, 2)
  status            String?   @db.VarChar(45)
  isActive          Int?      @default(1) @db.TinyInt
  isDelete          Int?      @default(0) @db.TinyInt
  created_at        DateTime? @default(now()) @db.Timestamp(0)
  updated_at        DateTime? @default(now()) @db.Timestamp(0)
  createdBy         Int?
  modifiedBy        Int?
  paymentMethod     Int?   
  upiId             String?   @db.VarChar(45)
  accountNumber     String?   @db.VarChar(45)
  ifscCode          String?   @db.VarChar(45)
  accountHolderName String?   @db.VarChar(100)

  astrologer    astrologers?    @relation(fields: [astrologerId], references: [id])
  withdrawmethod withdrawmethods? @relation(fields: [paymentMethod], references: [id])

  @@index([astrologerId], map: "withdrawrequest_astrologer_idx")
}

model withdraws {
  id             BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  astrologerId   BigInt    @db.UnsignedBigInt
  withdrawAmount Float
  status         String    @db.VarChar(255)
  isActive       Boolean   @default(true)
  isDelete       Boolean   @default(false)
  created_at     DateTime? @db.Timestamp(0)
  updated_at     DateTime? @db.Timestamp(0)
  createdBy      Int
  modifiedBy     Int

  @@index([astrologerId], map: "withdraws_astrologerid_foreign")
}

model ai_chat_histories {
  id                      BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  user_id                 BigInt    @db.UnsignedBigInt
  ai_astrologer_id        BigInt    @db.UnsignedBigInt
  chat_min                String?   @db.VarChar(255)
  chat_rate               String?   @db.VarChar(255)
  inr_usd_conversion_rate Int       @default(1)
  deduction               String?   @db.VarChar(255)
  chat_duration           String?   @db.VarChar(255)
  is_free                 String?   @db.VarChar(255)
  created_at              DateTime? @default(now()) @db.Timestamp(0)
  updated_at              DateTime? @default(now()) @db.Timestamp(0)

  aiastrologer aiastrologers @relation("AiAstrologerToChatHistories", fields: [ai_astrologer_id], references: [id])

  @@index([ai_astrologer_id], map: "ai_chat_histories_ai_astrologer_id_foreign")
  @@index([user_id], map: "ai_chat_histories_user_id_foreign")
}

model aiastrologers {
  id                   BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  name                 String    @db.VarChar(255)
  image                String?   @db.VarChar(255)
  about                String?   @db.Text
  astrologerCategoryId String?   @db.VarChar(255)
  primary_skill        String?   @db.VarChar(255)
  all_skills           String?   @db.VarChar(255)
  chat_charge          String?   @db.VarChar(255)
  chat_charge_usd      String?   @db.VarChar(255)
  experience           String?   @db.VarChar(255)
  system_intruction    String?   @db.Text
  slug                 String?   @db.VarChar(255)
  type                 String?   @db.VarChar(255)
  aiType               String?   @db.VarChar(255)
  referral_code        String?   @db.VarChar(50)
  created_at           DateTime? @default(now()) @db.Timestamp(0)
  updated_at           DateTime? @db.Timestamp(0)
  featured             Int
  
  aiChatHistories ai_chat_histories[] @relation("AiAstrologerToChatHistories")
  wallettransactions   wallettransaction[] @relation("AiAstroWalletRelation")
  aiFollowers astrologer_followers[] @relation("AiAstroFollowers")
  order_requests order_request[] @relation("AiAstroOrders")

}




