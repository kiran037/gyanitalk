  modifiedBy     Int

  astrologer    astrologers?     @relation(fields: [astrologerId], references: [id])
  user          users?            @relation("UserFollowers", fields: [userId], references: [id])
  aiAstrologer  aiastrologers?   @relation("AiAstroFollowers", fields: [aiAstrologerId], references: [id])

  @@index([astrologerId], map: "astrologer_followers_astrologerid_foreign")
  @@index([userId], map: "astrologer_followers_userid_foreign")
}

model astrologer_gifts {
  id           BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  astrologerId BigInt    @db.UnsignedBigInt
  userId       BigInt    @db.UnsignedBigInt
  giftId       BigInt    @db.UnsignedBigInt
  giftAmount   Decimal?  @db.Decimal(10, 2)
  isActive     Boolean   @default(true)
  isDelete     Boolean   @default(false)
  created_at   DateTime? @db.Timestamp(0)
  updated_at   DateTime? @db.Timestamp(0)
  createdBy    Int
  modifiedBy   Int
 
  user         users?     @relation("UserGiftsRelation", fields: [userId], references: [id])
  gift         gifts?     @relation("GiftsRelation", fields: [giftId], references: [id])
  astrologer   astrologers? @relation("AstrologerGiftsRelation", fields: [astrologerId], references: [id])

  @@index([astrologerId], map: "astrologer_gifts_astrologerid_foreign")
  @@index([giftId], map: "astrologer_gifts_giftid_foreign")
  @@index([userId], map: "astrologer_gifts_userid_foreign")
}

model astrologer_groups {
